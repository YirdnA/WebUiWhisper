# --- WebUiWhisper environment ---
# Copy to .env and fill in. Never commit .env.

# Upstream whisper API. In production compose this is http://whisper:8000.
# For local dev against the on-host service: http://127.0.0.1:8000
# For local dev against a mock: e.g. http://127.0.0.1:9999
WHISPER_API_URL=http://whisper:8000

# Filesystem layout inside the container. The defaults match the production
# compose mounts; override only if you're running outside the container.
CALLS_DIR=/calls
TRANSCRIPTS_DIR=/transcripts
BACKUP_DIR=/backup
STATE_DB_PATH=/var/lib/webuiwhisper/state.db
LOG_DIR=/transcripts

# Session signing key (used by itsdangerous). 32+ random bytes, hex or base64.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace-me-with-a-real-secret

# Trust the Remote-User header from Apache htpasswd auth (Tier A/B).
# In Tier C this is replaced by app-level login.
REMOTE_USER_HEADER=Remote-User
TRUST_REMOTE_USER=true

# Local-dev convenience: when there's no Apache in front, requests have no
# Remote-User. Set DEV_FALLBACK_USER=dev so the app treats anyone as "dev".
# Leave EMPTY in production.
DEV_FALLBACK_USER=

# Upload cap (bytes). Matches the whisper API's 500 MB ceiling.
MAX_UPLOAD_BYTES=524288000

# Rate-limit budgets (per IP).
RATE_READS_PER_MIN=60
RATE_WRITES_PER_MIN=10

# Login lockout (Tier C — placeholder honored at Tier A for IP-level brute
# force on /login if ever exposed).
LOGIN_FAILS_BEFORE_LOCKOUT=5
LOGIN_LOCKOUT_MINUTES=15

# Default transcription model for new uploads from the UI.
DEFAULT_MODEL=large-v3
